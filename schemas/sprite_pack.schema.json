{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifighterforge.local/schemas/sprite_pack.schema.json",
  "title": "AI Fighter Sprite Pack",
  "type": "object",
  "required": ["version", "fighter", "sheet", "animations"],
  "properties": {
    "version": { "type": "string" },
    "fighter": {
      "type": "object",
      "required": ["name", "prompt", "seed", "styleGuide"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer" },
        "styleGuide": { "type": "string", "minLength": 1 }
      }
    },
    "sheet": {
      "type": "object",
      "required": ["path", "frameWidth", "frameHeight"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "frameWidth": { "type": "integer", "minimum": 16 },
        "frameHeight": { "type": "integer", "minimum": 16 }
      }
    },
    "animations": {
      "type": "object",
      "required": ["idle", "run", "jump", "light", "heavy", "special", "block", "hit"],
      "additionalProperties": false,
      "properties": {
        "idle": { "$ref": "#/$defs/animation" },
        "run": { "$ref": "#/$defs/animation" },
        "jump": { "$ref": "#/$defs/animation" },
        "light": { "$ref": "#/$defs/animation" },
        "heavy": { "$ref": "#/$defs/animation" },
        "special": { "$ref": "#/$defs/animation" },
        "block": { "$ref": "#/$defs/animation" },
        "hit": { "$ref": "#/$defs/animation" }
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "animation": {
      "type": "object",
      "required": ["fps", "frames"],
      "properties": {
        "fps": { "type": "integer", "minimum": 1, "maximum": 60 },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/frame" }
        }
      }
    }
  }
}
